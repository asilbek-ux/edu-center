# ==============================================================================
# EduCenter ERP/LMS — Environment Variables Configuration
# ==============================================================================

# 1. Supabase Loyihasi Sozlamalari (Dashboard -> Project Settings -> API)
# URL: Project URL (masalan: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Key: Project API Keys -> anon / public (brauzer va mijoz tomoni uchun xavfsiz)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Ilova asosiy manzili (mahalliy yoki production domen)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Server-Only Maxfiy Kalitlar (FAQAT serverda ishlatiladi, brauzerga chiqmaydi!)
# Service Role Key: Project API Keys -> service_role (RLS cheklovlarini aylanib o'tuvchi boshqaruv kaliti)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 3. Telegram Bot Integratsiyasi (@BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-string
